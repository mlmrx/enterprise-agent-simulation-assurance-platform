# Local SQLite is the zero-configuration default.
DATABASE_URL=file:./data/easap.db

# Set both values for a remote libSQL/Turso database on a stateless host.
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# local: only loopback requests receive the development identity.
# shared-token: remote requests require EASAP_API_TOKEN plus x-easap-* headers.
# trusted-proxy: an upstream identity proxy must overwrite all x-easap-* headers.
EASAP_AUTH_MODE=local
# EASAP_API_TOKEN=

# Used for absolute Open Graph URLs. Defaults to http://localhost:3000.
EASAP_PUBLIC_URL=http://localhost:3000
